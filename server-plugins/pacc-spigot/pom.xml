<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.potatotv.pacc</groupId>
    <artifactId>pacc-spigot</artifactId>
    <version>6.0.0</version>
    <packaging>jar</packaging>
    <name>PACC Spigot</name>
    <description>PACC 的 Spigot 服务端插件产物：主类 PaccSpigotPlugin 继承 pacc-bukkit 共享适配层，
        另附 spigot-api 编译声明。Paper 专有 API 在运行时缺失时自动降级，默认仅告警。</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spigot.api.version>1.20.4-R0.1-SNAPSHOT</spigot.api.version>
        <plugin.api.version>1.20</plugin.api.version>
    </properties>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- 平台层复用 pacc-bukkit；主类只是它的继承，检测逻辑不重复实现。 -->
        <dependency>
            <groupId>com.potatotv.pacc</groupId>
            <artifactId>pacc-bukkit</artifactId>
            <version>6.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${spigot.api.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- plugin.yml 的 api-version 随 profile 变化；其它资源原样拷贝，不做过滤。 -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <minimizeJar>false</minimizeJar>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- P-01 / R-08：26.x 编译坐标。Spigot API 从 26.x 起仍是 -R0.1-SNAPSHOT 口径；
             需要 JDK 25 才能读取 26.x 的 API 产物。mc26 钉 26.2，mc263 钉 26.3。 -->
        <profile>
            <id>mc26</id>
            <properties>
                <spigot.api.version>26.2-R0.1-SNAPSHOT</spigot.api.version>
                <plugin.api.version>26.2</plugin.api.version>
            </properties>
        </profile>
        <profile>
            <id>mc263</id>
            <properties>
                <spigot.api.version>26.3-R0.1-SNAPSHOT</spigot.api.version>
                <plugin.api.version>26.3</plugin.api.version>
            </properties>
        </profile>
    </profiles>
</project>
