<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.potatotv.pacc</groupId>
    <artifactId>pacc-bukkit</artifactId>
    <version>6.0.0</version>
    <packaging>jar</packaging>
    <name>PACC Bukkit Adapter</name>
    <description>PACC 的 Bukkit API 共享适配层：平台适配、事件监听、配置映射与 PTV 上报。
        Paper 与 Spigot 插件共用这一层，仅入口声明与打包产物不同。编译期依赖 spigot-api（provided），
        运行时由服务端提供 Bukkit API；Paper 专有 API 一律走反射，缺失时自动降级。</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- PacketEvents 2.13.0 起已支持 Minecraft 26.1 / 26.2；2.14.0 在其之上。
             这里只用于编译期接口，运行期由服务端上的 PacketEvents 插件提供，见 plugin.yml 的 softdepend。 -->
        <packetevents.version>2.14.0</packetevents.version>
    </properties>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- PacketEvents 的发布仓库（CodeMC）。只用于编译期接口，运行期由服务端上的
             PacketEvents 插件提供，见 plugin.yml 的 softdepend。 -->
        <repository>
            <id>codemc</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.potatotv.pacc</groupId>
            <artifactId>pacc-server-core</artifactId>
            <version>6.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.20.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- provided 而不是 shaded：PacketEvents 的 spigot 产物自带 plugin.yml，打进产物会
             与本插件冲突；并且它体量大，不该塞进每个服务端插件的 jar。运行时缺这个插件时
             适配层自动退回事件口径（见 PacketEventsBridge 的类注释）。 -->
        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>${packetevents.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
