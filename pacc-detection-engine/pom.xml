<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.potatotv.pacc</groupId>
    <artifactId>pacc-detection-engine</artifactId>
    <version>6.0.0</version>
    <name>PACC Detection Engine</name>
    <description>PACC 检测引擎：玩家行为画像、作弊指纹库、玩家端六层检测（L1-L4）、
        服务端物理预测引擎（GrimAC 式）、战斗/数据包/行为检测、六层证据融合判定与威胁情报。
        《PACC 检测引擎专项升级技术文档》v1.0 的落地实现。纯 JDK 标准库实现。</description>

    <url>https://github.com/EPOTATOTV/PACC4_0</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>potatotv</id>
            <name>PotatoTV</name>
            <organization>PotatoTV</organization>
            <organizationUrl>https://github.com/EPOTATOTV</organizationUrl>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/EPOTATOTV/PACC4_0.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/EPOTATOTV/PACC4_0.git</developerConnection>
        <url>https://github.com/EPOTATOTV/PACC4_0</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- 零依赖是硬约束：运行时只用 JDK 标准库。
                 只允许 test 作用域（JUnit）。主代码一旦引入第三方依赖，构建直接失败。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>enforce-zero-dependencies</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>*:*:*:*:compile</exclude>
                                        <exclude>*:*:*:*:runtime</exclude>
                                    </excludes>
                                    <message>pacc-detection-engine 运行时必须零第三方依赖（仅允许 test 作用域的 JUnit）。</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
